(version 1)

(rule edge
	(condition "A.memberOf('edgepads')")
	(constraint edge_clearance (min 0.1mm))
    (constraint annular_width (min 0.0mm))
)

(rule testpoint_courtyard_ignore
    (severity exclusion)
    (constraint courtyard_clearance)
    (condition "A.Reference == 'TP*' && B.Reference == 'J*'")
)

(rule mountinghole_clearance_ignore
    (severity exclusion)
    (constraint hole_clearance)
    (constraint bridged_mask)
    (condition "A.Reference == 'H*' || A.Reference == 'Module*' || A.Reference == 'J*'")
)

(rule mountinghole_courtyard_ignore
    (severity exclusion)
    (constraint courtyard_clearance)
    (condition "A.Reference == 'Module*' && B.Reference == 'J*'")
)
